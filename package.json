{
  "name": "accurate-mcp",
  "version": "0.1.0",
  "description": "MCP server (read-only) untuk Accurate Online, berbasis Express",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "start:stdio": "node --env-file=.env server.js --stdio",
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js"
  },
  "engines": { "node": ">=20.6" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  }
}
