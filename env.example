# ============ Kredensial Accurate Online (API Token) ============
# Urutan mendapatkannya (detail di README):
#  1) Area Developer (account.accurate.id/developer) > Aplikasi > API Token > Aktifkan API Token
#     -> dapat "App Key" dan "Signature Secret"
#  2) Di Data Usaha (sebagai Administrator): Pengaturan > Accurate Store > Aplikasi Saya > Install Aplikasi (isi App Key)
#  3) Accurate Store > API Token > Buat API Token -> salin token-nya
#     SARAN KERAS: buat token dari user berperan Operator dengan Akses Grup khusus LIHAT (view) saja.
#
# API Token hasil langkah 3 (dipakai sebagai Bearer token). JANGAN dibagikan/ditempel ke chat.
ACCURATE_BEARER_TOKEN=
# "Signature Secret" dari langkah 1 (untuk membuat X-Api-Signature). JANGAN dibagikan.
ACCURATE_API_SECRET=
# Encoding hasil HMAC-SHA256 (contoh di dokumentasi Accurate memakai base64).
ACCURATE_SIG_ENCODING=base64

# ============ Katalog endpoint baca ============
# Daftar endpoint yang boleh dipanggil diturunkan dari spesifikasi OpenAPI resmi Accurate.
ACCURATE_SPEC_URL=https://account.accurate.id/open-api/json.do
# Opsional: pakai salinan lokal (file JSON) bila server tidak bisa mengunduh spesifikasi.
ACCURATE_SPEC_FILE=

# ============ Laporan laba rugi (get_profit_loss) ============
PL_ENDPOINT=glaccount/get-pl-account-amount.do
PL_PARAM_START=fromDate
PL_PARAM_END=toDate
PL_DATE_FORMAT=dmy

# ============ Mode HTTP (npm start) ============
PORT=3000
HOST=127.0.0.1
# Token pelindung endpoint /mcp (wajib di mode HTTP; tidak dipakai di mode stdio).
# Buat acak, mis: openssl rand -hex 32
MCP_AUTH_TOKEN=
